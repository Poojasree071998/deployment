# Redis Configuration
REDIS_URL=redis://localhost:6379

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/paas-platform

# Docker Registry Configuration (Optional)
# If provided, the deployer will push images to this registry.
REGISTRY_URL=docker.io
REGISTRY_USER=your_docker_hub_username
REGISTRY_PASSWORD=your_docker_hub_token_or_password
