{
  "name": "paas-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "dashboard"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=dashboard\" \"npm run dev --workspace=@paas/backend\" \"npm run dev --workspace=@paas/deployer\"",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspaces",
    "test:deploy": "node scripts/test-deploy.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
