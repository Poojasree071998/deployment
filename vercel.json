{
  "version": 2,
  "public": true,
  "name": "mini-paas-dashboard",
  "buildCommand": "npm run build --workspace=dashboard",
  "outputDirectory": "dashboard/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_BASE": "https://paas-backend.onrender.com/api"
  }
}
